/* The kit's screens. Exasol green for the accent; everything else the terminal's own colours. */

Screen {
    layout: vertical;
}

#header {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

#body {
    height: 1fr;
}

#plan {
    width: 36%;
    min-width: 24;
    max-width: 48;
    border: round $accent;
    border-title-color: $accent;
    padding: 0 1;
}

#plan Static {
    height: auto;
}

#log {
    border: round $panel;
    padding: 0 1;
    height: 1fr;
}

#status {
    height: 1;
    padding: 0 2;
    background: $panel;
}

ModalScreen {
    align: center middle;
}

#dialog {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#dialog Label {
    width: 100%;
}

#title {
    text-style: bold;
    margin-bottom: 1;
}

#hint {
    color: $text-muted;
    margin-top: 1;
}

#choices {
    height: auto;
    max-height: 20;
}

#buttons {
    height: auto;
    margin-top: 1;
}

#buttons Button {
    margin-right: 2;
}
