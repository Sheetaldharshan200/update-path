cmd_skills_install() {
    exakit_init_logging
    exakit_install_skills || die "Could not install the kit's AI skills"
}

cmd_marketplace() {
    [ -f "$EXAKIT_MANIFEST" ] || die "No installation found. Run the installer first."
    exakit_init_logging
    exakit_marketplace_menu "$@"
}

usage() {
    # `exakit help --all` prints the full command reference: the leading
    # comment block (from line 2) up to the first non-comment line — no
    # hardcoded range, so new command lines always appear instead of being
    # silently truncated. Plain `exakit help` (and a bare `exakit`) prints
    # only the short everyday list below, so a first-time user sees a handful
    # of commands, not the whole surface. Mirrors PowerShell Show-ExakitUsage.
    if [ "${1:-}" = "--all" ] || [ "${1:-}" = "-a" ]; then
        awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"
        return
    fi
    cat <<'EOF'
exakit — Exasol Personal Local Starter Kit

Get started:
  exakit mcp-setup     connect your AI assistant (Claude, Cursor, Codex)

Everyday commands:
  status               is the database up and healthy?
  info                 show your connection details
  start | stop         run or pause the database and add-on services
  autostart [on|off]   come back automatically after a restart
  data-load            load the sample data or your own CSV / Parquet
  mcp-doctor           check the AI (MCP) connection
  logs [target]        installer, database and service logs
  marketplace          optional add-ons (dashboards & more)

Keeping up to date:
  version              which versions you have, and which are tested
  update-check         what would change, and what it involves
  update               apply what is waiting, asking first before it
                       stops the database
EOF
}

# cmd_info_json — the install record, verbatim, on stdout.
#
# manifest.json is what every other command reads: which runtime, which versions,
# which paths, what the last data load did. `exakit info --json` hands that to a
# script or a support thread without anyone having to know where the file lives.
#
# Printed byte for byte rather than re-serialised: this is a copy of the file, and
# a reformatting step could only make it disagree with the file. The writer already
# emits two-space-indented JSON with a trailing newline (manifest_set).
#
# Nothing else may reach stdout on this path — no banner, no update notice, no
# hint — or the output stops being JSON. The dispatcher keeps it out of
# `_with_notice` for exactly that reason, and the failure below goes to stderr.
#
# Secrets are not a concern here: the manifest stores password *file paths*
# (runtime.password_file, components.mcp_server.connection.password_file), never a
# password. Keep it that way.
cmd_info_json() {
    [ -s "$EXAKIT_MANIFEST" ] || die "No install record to print ($EXAKIT_MANIFEST). Install the kit first."
    cat "$EXAKIT_MANIFEST"
}

# cmd_whats_new [version] — what changed, for this kit or a named one.
#
# Defaults to the version actually installed rather than the newest section in the
# file: a user on 0.2.0 asking what is new wants their own release notes, not a
# preview of one they do not have yet.
cmd_whats_new() {
    _cwn_version="${1:-}"
    if [ -z "$_cwn_version" ]; then
        _cwn_version="$(exakit_kit_bundled_version 2>/dev/null || true)"
        [ -n "$_cwn_version" ] || _cwn_version="$(manifest_get kit.version 2>/dev/null || true)"
    fi
    [ -n "$_cwn_version" ] || die "Could not tell which kit version this is. Name one: exakit whats-new 0.2.0"
    if ! exakit_print_whats_new "$_cwn_version" "What's new in $_cwn_version"; then
        _cwn_root="$(exakit_repo_root 2>/dev/null || true)"
        if [ -n "$_cwn_root" ] && [ -f "$_cwn_root/WHATS-NEW.md" ]; then
            info "No notes for $_cwn_version. Versions covered:"
            sed -n 's/^## \(.*\)$/      \1/p' "$_cwn_root/WHATS-NEW.md"
        else
            info "This kit copy does not carry WHATS-NEW.md."
        fi
    fi
}

# cmd_catalog [search] — render the searchable command catalog from the shared
# catalog.tsv (one source of truth for both the bash and PowerShell CLIs).
cmd_catalog() {
    _search="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"
    _catalog="$_lib_dir/catalog.tsv"
    [ -f "$_catalog" ] || die "Catalog data not found: $_catalog"

    if [ -t 1 ]; then
        _cy=$'\033[36m'; _cyb=$'\033[1;36m'; _dim=$'\033[2m'; _b=$'\033[1m'; _gn=$'\033[1;32m'; _r=$'\033[0m'
    else
        _cy=; _cyb=; _dim=; _b=; _gn=; _r=
    fi
    _rule='━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'

    printf '\n  %s%s%s\n' "$_cy" "$_rule" "$_r"
    printf '   %s▸ EXASOL%s  %s·%s  starter kit\n' "$_cyb" "$_r" "$_dim" "$_r"
    if [ -n "$_search" ]; then
        printf '     %scommand catalog — results for "%s"%s\n' "$_dim" "$_search" "$_r"
    else
        printf '     %scommand catalog · exakit · exapump · exasol%s\n' "$_dim" "$_r"
    fi
    printf '  %s%s%s\n\n' "$_cy" "$_rule" "$_r"

    _found=0
    for _tool in exakit exapump exasol; do
        # Emit fields separated by US (0x1f), a non-whitespace char: `read` with
        # a tab IFS collapses the empty options field (tab is IFS-whitespace),
        # which would merge no-option commands onto their description line.
        _rows="$(awk -F'\t' -v tool="$_tool" -v q="$_search" '
            NR==1 {next}
            $1==tool {
                hay=tolower($1" "$2" "$3" "$4)
                if (q=="" || index(hay,q)>0) print $2"\037"$3"\037"$4
            }' "$_catalog")"
        [ -z "$_rows" ] && continue
        _found=1
        case "$_tool" in
            exakit)  _label='exakit   — kit lifecycle & MCP management' ;;
            exapump) _label='exapump  — data loading CLI' ;;
            exasol)  _label='exasol   — database & AI (MCP) bridge' ;;
        esac
        printf '  %s%s%s\n' "$_gn" "$_label" "$_r"
        printf '%s\n' "$_rows" | while IFS=$(printf '\037') read -r _cmd _opt _desc; do
            if [ "$_tool" = "exasol" ]; then _name="$_cmd"; else _name="$_tool $_cmd"; fi
            if [ -n "$_opt" ]; then
                printf '    %s%s%s %s%s%s\n' "$_b" "$_name" "$_r" "$_dim" "$_opt" "$_r"
            else
                printf '    %s%s%s\n' "$_b" "$_name" "$_r"
            fi
            printf '        %s\n' "$_desc"
        done
        printf '\n'
    done

    if [ "$_found" -eq 0 ]; then
        printf '  %sNo commands match "%s".%s  Try: exakit catalog mcp\n\n' "$_dim" "$_search" "$_r"
        return 0
    fi
    printf '  %sTip:%s exakit catalog <search>   e.g. exakit catalog data · exakit catalog mcp\n\n' "$_dim" "$_r"
}

# _with_notice <command...> — run a command, then let the update notice speak.
# The command's own exit status is preserved: version news must never change what
# `exakit mcp-doctor` (or anything else) reports to a script.
#
# Only the commands below carry it. update-check and update render version state
# themselves, `version` has its own always-on hint, uninstall is a farewell, and
# help/catalog are reference screens that stay instant and clean.
_with_notice() {
    "$@"
    _wn_rc=$?
    exakit_notice_after_command || true
    return $_wn_rc
}

case "${1:-help}" in
    preflight) _with_notice preflight_report ;;
    status)   _with_notice cmd_status ;;
    version|--version|-v)  cmd_version ;;
    update-check) shift; cmd_update_check "${1:-all}" ;;
    update) shift; cmd_update "$@" ;;
    info)     shift
              case "${1:-}" in
                  --json|-j) cmd_info_json ;;
                  *) _with_notice connection_panel ;;
              esac ;;
    guide)    _with_notice exakit_guide ;;
    start)    _with_notice cmd_start ;;
    stop)     _with_notice cmd_stop ;;
    autostart) shift; _with_notice cmd_autostart "${1:-}" ;;
    data-load) shift; _with_notice cmd_data_load "${1:-}" ;;
    mcp-setup) _with_notice cmd_mcp_setup ;;
    mcp-repair) shift; _with_notice cmd_mcp_repair "$@" ;;
    mcp-doctor) shift; _with_notice cmd_mcp_doctor "$@" ;;
    mcp-status) shift; _with_notice cmd_mcp_status "$@" ;;
    mcp-validate) shift; _with_notice cmd_mcp_validate "$@" ;;
    mcp-remove) shift; _with_notice cmd_mcp_remove "$@" ;;
    mcp-restore) shift; _with_notice cmd_mcp_restore "$@" ;;
    skills-install) _with_notice cmd_skills_install ;;
    marketplace) shift; _with_notice cmd_marketplace "$@" ;;
    upgrade-kit2)  cmd_kit2_script upgrade-kit2.sh ;;
    rollback-kit2) cmd_kit2_script rollback-kit2.sh ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    whats-new) shift; cmd_whats_new "${1:-}" ;;
    logs)     shift; cmd_logs "$@" ;;
    catalog)  shift; cmd_catalog "${1:-}" ;;
    help|-h|--help) shift; usage "${1:-}" ;;
    *) echo "exakit: unknown command '${1}'" >&2; usage >&2; exit 2 ;;
esac
